#!/bin/bash
# movecarlite 生命周期脚本：start | stop | status | restart
# 运行时身份由 config/privilege 决定（package），本脚本不假设自己是 root。

APP_NAME="movecarlite"
APP_DIR="/var/apps/${APP_NAME}"

# 兼容 SSH 手工调试（此时 fnOS 变量不存在）
PKGVAR="${TRIM_PKGVAR:-/vol1/@appdata/${APP_NAME}}"
APPDEST="${TRIM_APPDEST:-${APP_DIR}/target}"
PKGETC="${TRIM_PKGETC:-/vol1/@appconf/${APP_NAME}}"

LOG_FILE="${PKGVAR}/info.log"
PID_FILE="${PKGVAR}/app.pid"
PASS_FILE="${PKGVAR}/admin.password"

# 飞牛统一网关：反代 / 中继 / 域名访问都走这个 unix socket，与端口无关
GATEWAY_SOCKET="${APPDEST}/app.sock"
GATEWAY_PREFIX="/app/movecarlite"

# 端口：安装/配置向导写入的 ui_port 优先，其次 manifest 的 service_port
PORT="${ui_port:-${TRIM_SERVICE_PORT:-18100}}"
case "$PORT" in
    ''|*[!0-9]*) PORT=18100 ;;
esac

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null
}

find_python() {
    local c
    for c in /usr/bin/python3 /usr/local/bin/python3 /usr/bin/python3.12 /usr/bin/python3.11; do
        [ -x "$c" ] && { echo "$c"; return 0; }
    done
    command -v python3 2>/dev/null && return 0
    return 1
}

check_pid() {
    local pid="${1:-}"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# 兜底：pidfile 丢了也能找到我们的进程（cmdline 形如 .../movecarlite/app.py 或 .../movecarlite/target/app.py）
find_procs() {
    pgrep -f "/movecarlite/(target/)?app\.py$" 2>/dev/null
}

is_running() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')
        if check_pid "$pid"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    local p
    p=$(find_procs | head -n 1)
    if [ -n "$p" ]; then
        echo "$p" > "${PID_FILE}"
        return 0
    fi
    return 1
}

start_app() {
    if is_running; then
        log_msg "已在运行（pid $(cat "${PID_FILE}" 2>/dev/null)），跳过启动"
        return 0
    fi

    local PY
    PY=$(find_python)
    if [ -z "$PY" ]; then
        log_msg "启动失败：系统里找不到 python3"
        echo "启动失败：系统里找不到 python3（需要 fnOS 自带的 /usr/bin/python3）"
        return 1
    fi

    mkdir -p "${PKGVAR}/data" || return 1

    # 密码文件缺失时回退到向导变量，保证总能启动
    if [ ! -s "${PASS_FILE}" ]; then
        printf '%s\n' "${admin_password:-movecar123}" > "${PASS_FILE}"
        chmod 600 "${PASS_FILE}" 2>/dev/null
    fi

    local pwd_val
    pwd_val=$(head -n 1 "${PASS_FILE}" 2>/dev/null)

    export DATA_DIR="${PKGVAR}/data"
    export PORT="${PORT}"
    export ADMIN_PASSWORD="${pwd_val}"
    export PASSWORD_FILE="${PASS_FILE}"
    export TZ=Asia/Shanghai
    export PYTHONUNBUFFERED=1
    export HOME="${TRIM_PKGHOME:-${PKGVAR}}"
    export GATEWAY_SOCKET
    export GATEWAY_PREFIX

    rm -f "${GATEWAY_SOCKET}" 2>/dev/null

    log_msg "启动：port=${PORT} python=${PY} dest=${APPDEST} data=${DATA_DIR}"

    cd "${APPDEST}" 2>/dev/null || cd "${APP_DIR}" || return 1

    # 安装/配置流程里脚本以 root 身份执行，这里必须降权到应用用户，
    # 否则 stop 时（以应用用户身份运行）无权结束 root 进程。
    if [ "$(id -u)" = "0" ] && [ -n "${TRIM_USERNAME:-}" ] && \
       id -u "${TRIM_USERNAME}" >/dev/null 2>&1; then
        if command -v setpriv >/dev/null 2>&1; then
            log_msg "降权运行：${TRIM_USERNAME}(${TRIM_UID:-?}:${TRIM_GID:-?})"
            nohup setpriv "--reuid=${TRIM_UID}" "--regid=${TRIM_GID}" --init-groups \
                "$PY" "${APPDEST}/app.py" >> "${LOG_FILE}" 2>&1 &
        else
            log_msg "降权运行（su）：${TRIM_USERNAME}"
            nohup su -s /bin/sh "${TRIM_USERNAME}" -c "\"$PY\" \"${APPDEST}/app.py\"" \
                >> "${LOG_FILE}" 2>&1 &
        fi
    else
        nohup "$PY" "${APPDEST}/app.py" >> "${LOG_FILE}" 2>&1 &
    fi
    echo $! > "${PID_FILE}"

    sleep 2
    if is_running; then
        log_msg "启动成功 pid=$(cat "${PID_FILE}") port=${PORT}"
        return 0
    fi
    log_msg "启动失败，详见 ${LOG_FILE}"
    echo "服务启动失败，详见日志 ${LOG_FILE}"
    return 1
}

stop_app() {
    local pid pids
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')
        if check_pid "$pid"; then
            log_msg "停止进程 pid=${pid}"
            kill -TERM "$pid" 2>/dev/null
        fi
    fi
    pids=$(find_procs)
    if [ -n "$pids" ]; then
        log_msg "停止残留进程 ${pids}"
        # shellcheck disable=SC2086
        kill -TERM $pids 2>/dev/null
    fi

    local i=0
    while [ $i -lt 15 ]; do
        if [ -z "$(find_procs)" ] && ! check_pid "$pid"; then
            break
        fi
        sleep 1
        i=$((i + 1))
    done

    pids=$(find_procs)
    if [ -n "$pids" ]; then
        log_msg "强制结束 ${pids}"
        # shellcheck disable=SC2086
        kill -9 $pids 2>/dev/null
    fi
    rm -f "${PID_FILE}"
    rm -f "${GATEWAY_SOCKET}" 2>/dev/null

    sleep 1
    pids=$(find_procs)
    if [ -n "$pids" ]; then
        log_msg "警告：仍有进程存活 ${pids}（可能是别的用户启动的，无权结束）"
        echo "无法结束进程 ${pids}，请检查是否为 root 启动的残留" >&2
        return 1
    fi
    log_msg "已停止"
    return 0
}

case "$1" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    restart)
        stop_app
        start_app
        ;;
    status)
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "用法: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
